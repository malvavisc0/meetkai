# Env template for docker-compose.workers.yaml
# (morphik, pgvector, crawl4ai + their own redis).
# On the worker host: cp .env.workers.example .env
#
# Every secret below is required — docker compose refuses to act on the
# workers stack when one is missing or empty (guards against an empty
# morphik JWT signing key and unauthenticated endpoints).
#
# Shared secret: KAI_BRAIN_CRAWL4AI_TOKEN must equal the same var in the
# cockpit stack's .env so the cockpit can authenticate to crawl4ai.

TZ=Europe/Berlin

# Morphik JWT secret (used by the morphik container to sign/verify tokens).
# Generate a real one: openssl rand -hex 32
KAI_BRAIN_MORPHIK_JWT_SECRET=change-me-openssl-rand-hex-32
# Password the morphik container requires on /local/generate_uri (its
# LOCAL_URI_PASSWORD). Generate: openssl rand -hex 16
KAI_BRAIN_MORPHIK_LOCAL_PASSWORD=change-me-openssl-rand-hex-16
# Admin secret (morphik's ADMIN_SERVICE_SECRET) — authenticates the manual
# token-mint call (see KAI_BRAIN_MORPHIK_TOKEN in .env.example). Generate: openssl rand -hex 32
KAI_BRAIN_MORPHIK_ADMIN_SECRET=change-me-openssl-rand-hex-32
# Morphik Postgres backend credentials (used by both the morphik and
# pgvector containers). Generate a real password: openssl rand -hex 16
MORPHIK_POSTGRES_USER=morphik
MORPHIK_POSTGRES_PASSWORD=change-me-openssl-rand-hex-16
MORPHIK_POSTGRES_DB=morphik

# crawl4ai bearer token (shared with the cockpit stack).
KAI_BRAIN_CRAWL4AI_TOKEN=your-crawl4ai-token

# Morphik completion/embedding models call an OpenAI-compatible model router
# (base URL set by ROUTER_API_BASE, rendered into the docker-compose.workers.yaml
# configs.morphik TOML; the key is mapped into the container as OPENAI_API_KEY —
# litellm's standard env path).
ROUTER_API_KEY=sk-your-router-key

# --- Morphik model wiring (compose renders these into morphik.toml at
# config time; they are NOT passed into the containers) ---
ROUTER_API_BASE=https://router.requesty.ai/v1
MORPHIK_COMPLETION_MODEL=openai/claude-haiku-5-5
MORPHIK_VISION_MODEL=openai/gemini-3.8-flash
# The openai/ prefix makes litellm route via its plain OpenAI-compatible
# client with our api_base. Without it litellm hijacks recognized vendor
# names into its own provider clients (nebius/* -> Nebius, claude-* ->
# Anthropic, gemini-* -> Vertex) and the router never sees the call. The
# 1984-dim Qwen3 MRL truncation rides separately in the compose file via
# the embedding entry's extra_body.
MORPHIK_EMBEDDING_MODEL=openai/nebius/Qwen/Qwen3-Embedding-8B
