# Env template for docker-compose.yml (the cockpit box: cockpit + kai-postgres).
# Copy to .env: cp .env.example .env
#
# The worker services (morphik/crawl4ai) run in their own stack with its own
# env template (.env.workers.example). One secret must be kept identical
# across hosts:
#   - KAI_BRAIN_CRAWL4AI_TOKEN here == the same var in .env.workers.example

TZ=Europe/Berlin

KAI_COCKPIT_SECRET=change-me-openssl-rand-hex-32
KAI_COCKPIT_ESCALATION_SECRET=change-me-openssl-rand-hex-32
KAI_PUBLIC_URL=http://localhost:8080
# KAI_COOKIE_SECURE= # auto from KAI_PUBLIC_URL scheme; set 1 to force Secure even behind a proxy
# Cockpit DB. The compose stack overrides this with its own Postgres
# container (kai-postgres) via the cockpit service's environment — these
# credentials feed both that container and the KAI_COCKPIT_DB URL there.
# Bare-metal runs fall back to the built-in default sqlite:///data/cockpit.db.
# Fixed at first boot of the kai-postgres container — changing these later
# requires resetting the kai-postgres-data volume.
KAI_POSTGRES_USER=kai
KAI_POSTGRES_PASSWORD=change-me-openssl-rand-hex-16
KAI_POSTGRES_DB=kai
KAI_CONFIGS_DIR=/app/data/configs/cockpit
KAI_LOG_DIR=/app/logs
# KAI_COCKPIT_AUTO_APPROVE_LOGIN=true
# KAI_COCKPIT_TESTING=true

KAI_SMTP_HOST=mailpit
KAI_SMTP_PORT=1025
KAI_SMTP_FROM=support@meetk.ai
# KAI_SMTP_USER=resend
# KAI_SMTP_PASSWORD=re_your_api_key

KAI_CREDENTIAL_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
KAI_CREDENTIAL_KEY_VERSION=v1

KAI_LLM_API_BASE=https://api.openai.com/v1
KAI_LLM_API_KEY=sk-your-api-key
KAI_LLM_MODEL=gpt-4o-mini
# KAI_LLM_ENABLE_THINKING=false
# Max output tokens per LLM completion (bounds per-call spend). Default 2048.
# KAI_LLM_MAX_TOKENS=2048

KAI_AGENT_HISTORY_FOLDER=/app/data
# KAI_AGENT_MAX_HISTORY_MESSAGES=100
# KAI_AGENT_MAX_HISTORY_CHARS=12000
# KAI_AGENT_MAX_CONVERSATIONS=256
# KAI_AGENT_LANGUAGE=English
# KAI_AGENT_LANGUAGE_EXPLICIT=false
# KAI_TASKS_ENABLED=true
# KAI_TASKS_POLL_INTERVAL_SECONDS=5.0
KAI_TASKS_FOLDER=/app/data
KAI_ESCALATIONS_FOLDER=/app/data

KAI_BRAIN_BASE_URL=http://morphik:8000
# Bearer token for the brain tool. Mint it ONCE per environment, against that
# environment's own morphik (tokens are validated against morphik's DB), after
# morphik is up — then paste it here. From any host that can reach morphik:
#   curl -s -X POST http://morphik:8000/cloud/generate_uri \
#     -H 'Content-Type: application/json' \
#     -H "X-Morphik-Admin-Secret: $KAI_BRAIN_MORPHIK_ADMIN_SECRET" \
#     -d '{"name":"kai-cockpit","user_id":"kai","expiry_days":5475}'
# Response {"uri":"morphik://kai-cockpit:<jwt>@host"} — paste the <jwt> below.
KAI_BRAIN_MORPHIK_TOKEN=
KAI_BRAIN_CRAWLER_URL=http://crawl4ai:11235
KAI_BRAIN_CRAWL4AI_TOKEN=your-crawl4ai-token
# KAI_BRAIN_WORKSPACE=default
# KAI_BRAIN_INSTRUCTION=one trigger per line
# KAI_BRAIN_MANDATORY=false
# KAI_BRAIN_MANDATORY_TEMPERATURE=0.0
# KAI_BRAIN_CRAWL_MAX_DEPTH=1
# KAI_BRAIN_CRAWL_MAX_PAGES=25

# Morphik infra secrets (JWT/local/admin) and Postgres credentials live in
# .env.workers.example — the morphik container reads them, not the cockpit.

# KAI_SMTP_TOOL_HOST=smtp.example.com
# KAI_SMTP_TOOL_PORT=587
# KAI_SMTP_TOOL_USERNAME=user
# KAI_SMTP_TOOL_PASSWORD=password
# KAI_SMTP_TOOL_FROM_ADDRESS=user@example.com
# KAI_SMTP_TOOL_USE_TLS=true
# KAI_SMTP_TOOL_INSTRUCTION=one trigger per line

# KAI_SQL_DSN=postgresql://user:pass@host/db
# KAI_SQL_INSTRUCTION=one trigger per line
# KAI_SQL_ROW_LIMIT=100

# KAI_EMAIL_MAX_ATTACHMENT_BYTES=10485760

# OPENROUTER_API_KEY (morphik) lives in .env.workers.example.

# Error tracking (optional). Disabled by default: leave SENTRY_DSN empty and
# the Sentry client is a no-op — no error-tracking service is required for
# local dev. To enable, point SENTRY_DSN at any Sentry-compatible backend.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=meetkai@0.0.1+dev
